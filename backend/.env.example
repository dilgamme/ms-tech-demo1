# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://mstech-demo-resource.cognitiveservices.azure.com/
AZURE_OPENAI_KEY=your-api-key-here
USE_MANAGED_IDENTITY=false

# Model deployment names
DEEPSEEK_MODEL=DeepSeek-V4-Flash
ROUTER_MODEL=gpt-5.4-mini
REASONING_MODEL=gpt-5-pro-reasoning

# Microsoft Foundry Web IQ / Azure OpenAI web search
WEB_IQ_ENABLED=false
WEB_IQ_ENDPOINT=https://your-responses-api-region.cognitiveservices.azure.com/
WEB_IQ_MODEL=gpt-5.4-mini
WEB_IQ_SEARCH_CONTEXT_SIZE=medium
# Optional ISO country code used only as approximate search context.
WEB_IQ_COUNTRY=
WEB_IQ_TIMEOUT_SECONDS=45
WEB_IQ_MAX_SOURCES=5

# Azure Voice Live
VOICE_LIVE_ENDPOINT=https://mstech-demo-resource.services.ai.azure.com/
VOICE_LIVE_KEY=your-voice-live-key-here
VOICE_LIVE_MODEL=gpt-4o
VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural
VOICE_LIVE_API_VERSION=2025-10-01
# Optional. Defaults to https://ai.azure.com/.default for services.ai.azure.com endpoints.
VOICE_LIVE_TOKEN_SCOPE=

# Azure AI Translator
TRANSLATOR_ENABLED=true
TRANSLATOR_ENDPOINT=https://mstech-demo-resource.cognitiveservices.azure.com/
TRANSLATOR_REGION=westeurope
TRANSLATOR_API_VERSION=3.0

# Azure AI Search / repository-grounded self knowledge
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your-search-admin-or-query-key
AZURE_SEARCH_INDEX=rag-1779444354799
AZURE_SEARCH_VECTOR_ENABLED=false
SELF_KNOWLEDGE_RAG_ENABLED=true
GITHUB_REPOSITORY_URL=https://github.com/dilgamme/ms-tech-demo1

# Frontend URL (for CORS)
FRONTEND_URL=https://orange-hill-0db554803.7.azurestaticapps.net
